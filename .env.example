# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings > API). The publishable key is safe to ship in the app;
# row-level security protects the data. Never put the Anthropic key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
